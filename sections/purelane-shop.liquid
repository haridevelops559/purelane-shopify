{% liquid
  assign shop_collection = section.settings.collection
  if shop_collection == blank
    assign shop_collection = collections.all
  endif
%}

<section
  id="shop"
  class="sec purelane-shop"
  data-section-id="{{ section.id }}"
>
  <div class="wrap">

    <div class="panel-head">
      <span class="kicker">{{ section.settings.kicker }}</span>

      <h2 class="d2">{{ section.settings.heading }}</h2>

      <div class="rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
    </div>

    <div class="shelf">
      {% if shop_collection.products_count > 0 %}

        {% for product in shop_collection.products limit: section.settings.products_to_show %}
          {% render 'purelane-product-card',
            product: product
          %}
        {% endfor %}

      {% else %}

        <p class="purelane-shop__empty">
          Add products to the selected collection.
        </p>

      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop",
  "tag": "section",
  "class": "purelane-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop"
    }
  ]
}
{% endschema %}