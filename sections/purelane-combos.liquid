<section
  id="combos"
  class="sec purelane-combos"
  data-section-id="{{ section.id }}"
>
  <div class="wrap">

    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>

      <h2 class="d2">{{ section.settings.heading }}</h2>

      <div class="rule" aria-hidden="true">
        <i></i>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>

      {% if section.settings.description != blank %}
        <p class="lede">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="comborail rv">

      {% for block in section.blocks %}
        <article
          class="glass combo{% if block.settings.featured %} hero-combo{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="tray">

            {% if block.settings.save_label != blank %}
              <span class="save">{{ block.settings.save_label }}</span>
            {% endif %}

            {% if block.settings.flag != blank %}
              <span class="flag">{{ block.settings.flag }}</span>
            {% endif %}

            <div class="stack">

              {% if block.settings.product_1 != blank %}
                <span class="it">
                  {% render 'purelane-hero-product',
                    product: block.settings.product_1
                  %}
                  {% if block.settings.product_1_benefit != blank %}
                    <span>{{ block.settings.product_1_benefit }}</span>
                  {% endif %}
                </span>
              {% endif %}

              {% if block.settings.product_2 != blank %}
                <span class="plus" aria-hidden="true">+</span>

                <span class="it">
                  {% render 'purelane-hero-product',
                    product: block.settings.product_2
                  %}
                  {% if block.settings.product_2_benefit != blank %}
                    <span>{{ block.settings.product_2_benefit }}</span>
                  {% endif %}
                </span>
              {% endif %}

              {% if block.settings.product_3 != blank %}
                <span class="plus" aria-hidden="true">+</span>

                <span class="it">
                  {% render 'purelane-hero-product',
                    product: block.settings.product_3
                  %}
                  {% if block.settings.product_3_benefit != blank %}
                    <span>{{ block.settings.product_3_benefit }}</span>
                  {% endif %}
                </span>
              {% endif %}

            </div>
          </div>

          <div class="body">
            <h3>{{ block.settings.title }}</h3>

            <div class="cnt">
              {{ block.settings.product_count }} products
            </div>

            {% if block.settings.description != blank %}
              <p class="inc">{{ block.settings.description }}</p>
            {% endif %}

            <div class="prow">
              <strong>{{ block.settings.price }}</strong>

              {% if block.settings.compare_price != blank %}
                <s>{{ block.settings.compare_price }}</s>
              {% endif %}

              {% if block.settings.saving != blank %}
                <em>{{ block.settings.saving }}</em>
              {% endif %}
            </div>

            <div class="fine">
              {{ block.settings.fine_print }}
            </div>

            {% if block.settings.link != blank %}
              <a
                class="btn {% if block.settings.featured %}btn-primary{% else %}btn-ghost{% endif %}"
                href="{{ block.settings.link }}"
              >
                {{ block.settings.button_label }}

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h13m-5-6 6 6-6 6"/>
                </svg>
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}

    </div>

    <div class="swipecue" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h13m-5-6 6 6-6 6"/>
      </svg>
      Swipe for more combos
    </div>

    {% if section.settings.rail_note != blank %}
      <p class="railnote">{{ section.settings.rail_note }}</p>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos",
  "tag": "section",
  "class": "purelane-combos-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "textarea",
      "id": "rail_note",
      "label": "Rail note",
      "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen essentials"
        },
        {
          "type": "number",
          "id": "product_count",
          "label": "Product count",
          "default": 3
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "text",
          "id": "product_1_benefit",
          "label": "Product 1 benefit"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "text",
          "id": "product_2_benefit",
          "label": "Product 2 benefit"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "text",
          "id": "product_3_benefit",
          "label": "Product 3 benefit"
        },
        {
          "type": "text",
          "id": "save_label",
          "label": "Save label",
          "default": "You save ₹398"
        },
        {
          "type": "text",
          "id": "flag",
          "label": "Flag"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare-at price",
          "default": "₹897"
        },
        {
          "type": "text",
          "id": "saving",
          "label": "Saving",
          "default": "Save ₹398"
        },
        {
          "type": "text",
          "id": "fine_print",
          "label": "Fine print",
          "default": "Inclusive of all taxes · COD available"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured combo",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos",
      "blocks": [
        {
          "type": "combo"
        },
        {
          "type": "combo"
        },
        {
          "type": "combo"
        },
        {
          "type": "combo"
        },
        {
          "type": "combo"
        }
      ]
    }
  ]
}
{% endschema %}