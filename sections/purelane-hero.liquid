<section
  class="purelane-hero hero"
  data-section-id="{{ section.id }}"
  data-purelane-hero
>
  <div class="purelane-hero__grid hero-grid">
    <div class="purelane-hero__copy hero-copy">

      <div class="purelane-hero__badges badgestrip">
        <div>
          <span>✦</span>
          Plant powered
        </div>
        <div>
          <span>✦</span>
          Zero harsh chemicals
        </div>
      </div>

      {% if section.settings.eyebrow != blank %}
        <p class="purelane-hero__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      <h1>
        {{ section.settings.heading | escape }}
      </h1>

      {% if section.settings.description != blank %}
        <p class="purelane-hero__lede">
          {{ section.settings.description }}
        </p>
      {% endif %}

      <div class="hero-cta">
        {% if section.settings.primary_label != blank %}
          <a
            class="btn btn-primary"
            href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}"
          >
            {{ section.settings.primary_label | escape }}
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank %}
          <a
            class="btn btn-ghost"
            href="{{ section.settings.secondary_link | default: '#shop' }}"
          >
            {{ section.settings.secondary_label | escape }}
          </a>
        {% endif %}
      </div>

    </div>

    <div class="purelane-hero__product hero-prod">
      <div class="hstage" data-purelane-stage>

        

        <div class="hslide hs1 on" data-n="1">
          {% if section.settings.product_1 != blank %}
            {% render 'purelane-hero-product',
              product: section.settings.product_1,
              class: 'a d1'
            %}
          {% endif %}

          <div class="glass-2 ptag">
            <span class="lbl">
              {{ section.settings.state_1_label | escape }}
            </span>

            {% if section.settings.product_1 != blank %}
              <div class="val">
                <strong>
                  {{ section.settings.state_1_price | escape }}
                </strong>

                {% if section.settings.state_1_compare != blank %}
                  <s>{{ section.settings.state_1_compare | escape }}</s>
                {% endif %}
              </div>
            {% endif %}

            <span class="cut">
              {{ section.settings.state_1_saving | escape }}
            </span>
          </div>
        </div>

        <div class="hslide hs2" data-n="2">
          {% if section.settings.product_2 != blank %}
            {% render 'purelane-hero-product',
              product: section.settings.product_2,
              class: 'a d1'
            %}
          {% endif %}

          {% if section.settings.product_1 != blank %}
            {% render 'purelane-hero-product',
              product: section.settings.product_1,
              class: 'b d2'
            %}
          {% endif %}

          <div class="glass-2 ptag">
            <span class="lbl">
              {{ section.settings.state_2_label | escape }}
            </span>

            <div class="val">
              <strong>{{ section.settings.state_2_price | escape }}</strong>
              <s>{{ section.settings.state_2_compare | escape }}</s>
            </div>

            <span class="cut">
              {{ section.settings.state_2_saving | escape }}
            </span>
          </div>
        </div>

        <div class="hslide hs3" data-n="3">
          {% if section.settings.product_2 != blank %}
            {% render 'purelane-hero-product',
              product: section.settings.product_2,
              class: 'a d1'
            %}
          {% endif %}

          {% if section.settings.product_3 != blank %}
            {% render 'purelane-hero-product',
              product: section.settings.product_3,
              class: 'b d2'
            %}
          {% endif %}

          {% if section.settings.product_1 != blank %}
            {% render 'purelane-hero-product',
              product: section.settings.product_1,
              class: 'c d3'
            %}
          {% endif %}

          <div class="glass-2 ptag">
            <span class="lbl">
              {{ section.settings.state_3_label | escape }}
            </span>

            <div class="val">
              <strong>{{ section.settings.state_3_price | escape }}</strong>
              <s>{{ section.settings.state_3_compare | escape }}</s>
            </div>

            <span class="cut">
              {{ section.settings.state_3_saving | escape }}
            </span>
          </div>
        </div>

      </div>

      <div class="hdots" data-purelane-dots>
        <button type="button" class="on" data-slide="1" aria-label="Show 1 product"></button>
        <button type="button" data-slide="2" aria-label="Show 2 products"></button>
        <button type="button" data-slide="3" aria-label="Show 3 products"></button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Plant-based homecare"
