    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Hero product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Hero product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Hero product 3"
    },
    {
      "type": "text",
      "id": "state_1_label",
      "label": "State 1 label",
      "default": "Single bottle"
    },
    {
      "type": "text",
      "id": "state_1_price",
      "label": "State 1 price",
      "default": "₹200"
    },
    {
      "type": "text",
      "id": "state_1_compare",
      "label": "State 1 compare price",
      "default": "₹299"
    },
    {
      "type": "text",
      "id": "state_1_saving",
      "label": "State 1 saving",
      "default": "33% off"
    },
    {
      "type": "text",
      "id": "state_2_label",
      "label": "State 2 label",
      "default": "Any 2 products"
    },
    {
      "type": "text",
      "id": "state_2_price",
      "label": "State 2 price",
      "default": "₹349"
    },
    {
      "type": "text",
      "id": "state_2_compare",
      "label": "State 2 compare price",
      "default": "₹598"
    },
    {
      "type": "text",
      "id": "state_2_saving",
      "label": "State 2 saving",
      "default": "Save ₹249"
    },
    {
      "type": "text",
      "id": "state_3_label",
      "label": "State 3 label",
      "default": "Any 3 products"
    },
    {
      "type": "text",
      "id": "state_3_price",
      "label": "State 3 price",
      "default": "₹499"
    },
    {
      "type": "text",
      "id": "state_3_compare",
      "label": "State 3 compare price",
      "default": "₹897"
    },
    {
      "type": "text",
      "id": "state_3_saving",
      "label": "State 3 saving",
      "default": "Save ₹398"
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero"
    }
  ]
}
{% endschema %}