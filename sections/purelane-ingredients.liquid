<section id="ingredients" class="sec purelane-ingredients">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="panel-head">
        <h2 class="d2">{{ section.settings.heading }}</h2>

        <div class="rule" aria-hidden="true">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          <i></i>
        </div>
      </div>

      <div class="ing">

        <div class="ing-i">
          <div class="art">
            <svg viewBox="0 0 100 100" fill="none" stroke="#ece6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="50" cy="62" r="25"/>
              <path d="M31 53c9-6 29-6 38 0" stroke="#f0a03c"/>
              <path d="M41 63c4 8 14 8 18 0" opacity=".55"/>
              <path d="M50 37V25"/>
              <path d="M50 27C42 18 30 16 21 21c5 10 17 13 29 6Z" stroke="#f0a03c"/>
              <path d="M50 27c8-9 20-11 29-6-5 10-17 13-29 6Z" stroke="#f0a03c"/>
            </svg>
          </div>
          <h4>Coconut</h4>
          <p>Plant-derived cleansers that lift grease</p>
        </div>

        <div class="ing-i">
          <div class="art">
            <svg viewBox="0 0 100 100" fill="none" stroke="#ece6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="45" cy="58" r="23"/>
              <path d="M45 35v46M22 58h46" opacity=".4"/>
              <path d="M29 42 61 74M61 42 29 74" opacity=".26"/>
              <path d="M62 28c13-1 20 10 15 20-4 8-15 9-19 2" stroke="#f0a03c"/>
              <path d="M45 34c-3-8 2-15 10-16 1 9-3 15-10 16Z" stroke="#f0a03c"/>
            </svg>
          </div>
          <h4>Orange peel</h4>
          <p>Natural degreaser and fresh citrus lift</p>
        </div>

        <div class="ing-i">
          <div class="art">
            <svg viewBox="0 0 100 100" fill="none" stroke="#ece6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="50" cy="52" r="24"/>
              <path d="M34 52c6-13 26-13 32 0-6 13-26 13-32 0Z" stroke="#f0a03c"/>
              <path d="M39 52h22M50 41v22" opacity=".4"/>
              <path d="M50 28V18"/>
              <path d="M50 20c-7-8-17-8-23-2 6 7 15 8 23 2Z" stroke="#f0a03c"/>
              <path d="M50 20c7-8 17-8 23-2-6 7-15 8-23 2Z" stroke="#f0a03c"/>
            </svg>
          </div>
          <h4>Soap nut</h4>
          <p>A traditional plant foaming agent</p>
        </div>

        <div class="ing-i">
          <div class="art">
            <svg viewBox="0 0 100 100" fill="none" stroke="#ece6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M50 78C35 68 25 55 25 41c0-11 9-19 20-19 4 0 7 1 10 3 3-2 6-3 10-3 11 0 20 8 20 19 0 14-10 27-25 37Z"/>
              <path d="M50 78V32"/>
              <path d="M50 46c-8-7-16-8-22-7" opacity=".5"/>
              <path d="M50 56c8-7 16-8 22-7" opacity=".5"/>
              <path d="M50 66c-7-5-13-6-18-5" opacity=".35"/>
              <path d="M50 37c7-7 14-8 20-7" opacity=".35"/>
            </svg>
          </div>
          <h4>Neem</h4>
          <p>Time-tested antibacterial from the tree</p>
        </div>

        <div class="ing-i">
          <div class="art">
            <svg viewBox="0 0 100 100" fill="none" stroke="#ece6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M50 78V37"/>
              <path d="M50 52c-9-9-19-12-28-9 5 10 15 14 28 9Z" stroke="#f0a03c"/>
              <path d="M50 61c9-9 19-12 28-9-5 10-15 14-28 9Z" stroke="#f0a03c"/>
              <path d="M50 43c-6-10-5-19 1-25 7 8 7 17-1 25Z" stroke="#f0a03c"/>
              <path d="M50 70c-7-7-15-9-22-6 4 8 12 11 22 6Z" opacity=".55"/>
            </svg>
          </div>
          <h4>Lemongrass</h4>
          <p>Clean fragrance with nothing synthetic</p>
        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Ingredients",
  "tag": "section",
  "class": "purelane-ingredients-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sourced from nature"
    }
  ],
  "presets": [
    {
      "name": "Purelane Ingredients"
    }
  ]
}
{% endschema %}